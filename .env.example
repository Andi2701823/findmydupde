# Preparation only. Do not enter production credentials or enable access yet.
# Static npm run build does not use MySQL. Server endpoints require explicit opt-in.
DATABASE_ACCESS_ENABLED=false
CATALOG_SEARCH_ENABLED=false
DB_MIGRATIONS_ENABLED=false
AWIN_IMPORT_ENABLED=false
IMAGE_SEARCH_ENABLED=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u874339379_findmydupde
MYSQL_USER=u874339379_findmydup
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=2
# disabled is allowed only for local connections. Remote connections require TLS.
MYSQL_TLS_MODE=disabled
MYSQL_SSL_CA=

# Separate, least-privilege accounts. Never fall back to the runtime account.
MYSQL_MIGRATION_USER=
MYSQL_MIGRATION_PASSWORD=
MYSQL_IMPORT_USER=
MYSQL_IMPORT_PASSWORD=

# Default is a per-process shared request quota. Trust headers only after proxy verification.
TRUST_PROXY_HEADERS=false
CATALOG_MAX_AGE_DAYS=3

# Reserved for later authorized integrations. Not downloaded or contacted by this version.
AWIN_FEED_URL=
AWIN_ALLOWED_IMAGE_HOSTS=
OPENAI_API_KEY=
AWIN_RETAILER_ID=
AWIN_MERCHANT_ID=
AWIN_CATEGORY_MAPPING_JSON={}

# eBay Browse API (server-side only), disabled by default.
DEPLOYMENT_ENV=local
EBAY_SEARCH_ENABLED=false
EBAY_PRODUCTION_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_EPN_CAMPAIGN_ID=

# Shared, read-only Supabase connection for catalog merchants (server-side only).
# Use a Publishable Key (sb_publishable_), NEVER a service-role or secret key.
# Existing SAMSUNG_SUPABASE_* names remain supported during migration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SAMSUNG_CATALOG_ENABLED=false
