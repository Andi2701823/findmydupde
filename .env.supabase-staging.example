# FindMyDup: Supabase staging search (copy to Hostinger staging only).
# Never set these on the current findmydup.de production website.
NODE_ENV=production
NPM_CONFIG_INCLUDE=dev
DEPLOYMENT_ENV=staging

# The previous Hostinger MariaDB account is NOT used for this mode.
CATALOG_BACKEND=supabase
CATALOG_SEARCH_ENABLED=false
SUPABASE_CATALOG_ENABLED=false
DATABASE_ACCESS_ENABLED=false
DB_MIGRATIONS_ENABLED=false
AWIN_IMPORT_ENABLED=false
IMAGE_SEARCH_ENABLED=false
DB_CONNECTION_TEST_ENABLED=false
STAGING_CATALOG_DIAGNOSTICS=false
HOSTINGER_STAGING_GRANT_COMPATIBILITY=false

# Set only after the Supabase SQL schema and RLS checks are complete.
# Project URL: Supabase Dashboard > Connect > Project URL
SUPABASE_URL=
# ONLY the sb_publishable_... key; never secret/service_role/password.
SUPABASE_PUBLISHABLE_KEY=

CATALOG_MAX_AGE_DAYS=3
TRUST_PROXY_HEADERS=false
