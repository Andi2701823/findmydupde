{
  "name": "findmydup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/browser.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "serve": "python3 -m http.server 3000 --directory out"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.30",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "playwright-core": "1.64.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "overrides": {
    "brace-expansion@^5": "5.0.12",
    "brace-expansion@^1": "1.1.21"
  }
}
