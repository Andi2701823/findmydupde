    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.23",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.0",
    "playwright-core": "1.59.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
