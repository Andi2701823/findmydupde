{
  "name": "findmydup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/browser.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "serve": "python3 -m http.server 3000 --directory out",
    "dev:server": "node scripts/prepare-server.mjs && node --env-file-if-exists=.env node_modules/next/dist/bin/next dev server-app",
    "build:server": "node scripts/prepare-server.mjs && next build server-app --webpack && node scripts/package-server.mjs",
    "start:server": "node --env-file-if-exists=.env server-app/.next/standalone/server-app/server.js",
    "db:migrate": "node --env-file-if-exists=.env --conditions=react-server --experimental-strip-types scripts/migrate.ts",
    "test:db": "node --conditions=react-server --experimental-strip-types --test tests/mysql.integration.ts",
    "test:server": "node tests/server-browser.mjs",
    "awin:import": "node --env-file-if-exists=.env --conditions=react-server --experimental-strip-types scripts/import-awin.ts",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "mysql2": "3.24.6",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "playwright-core": "1.64.0",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "overrides": {
    "brace-expansion@^5": "5.0.12",
    "brace-expansion@^1": "1.1.21",
    "postcss-selector-parser": "7.1.6"
  }
}
