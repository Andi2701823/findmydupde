# Staging only. Add real values privately in hPanel or a protected operator .env.
# Never use the existing production database/account for staging.
NODE_ENV=production
# Build tools must be installed even when the host builds with NODE_ENV=production.
NPM_CONFIG_INCLUDE=dev
HOSTNAME=0.0.0.0
# PORT is assigned by Hostinger, do not override it.
DEPLOYMENT_ENV=staging
DATABASE_ACCESS_ENABLED=false
CATALOG_SEARCH_ENABLED=false
DB_MIGRATIONS_ENABLED=false
AWIN_IMPORT_ENABLED=false
IMAGE_SEARCH_ENABLED=false
DB_CONNECTION_TEST_ENABLED=false
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=2
# Remote connections require verified TLS. Localhost only may use disabled.
MYSQL_TLS_MODE=required
MYSQL_SSL_CA=
TRUST_PROXY_HEADERS=false
CATALOG_MAX_AGE_DAYS=3
# Migration credentials belong only in a separate maintenance environment.
MYSQL_MIGRATION_USER=
MYSQL_MIGRATION_PASSWORD=
